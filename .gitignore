# Root .gitignore for memo project

########################
# Backend (Spring Boot)
########################
HELP.md
backend/target/
!backend/.mvn/wrapper/maven-wrapper.jar
!backend/**/src/main/**/target/
!backend/**/src/test/**/target/

# STS
backend/.apt_generated
backend/.classpath
backend/.factorypath
backend/.project
backend/.settings
backend/.springBeans
backend/.sts4-cache

# IntelliJ IDEA
backend/.idea
backend/*.iws
backend/*.iml
backend/*.ipr

# NetBeans / generic Java build
backend/nbproject/private/
backend/nbbuild/
backend/dist/
backend/nbdist/
backend/.nb-gradle/
backend/build/
!backend/**/src/main/**/build/
!backend/**/src/test/**/build/

# VS Code
backend/.vscode/

########################
# Frontend (Expo / React Native)
########################

# dependencies
frontend/node_modules/
node_modules/

# Expo
frontend/.expo/
frontend/dist/
frontend/web-build/

# Native / credentials
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
frontend/.metro-health-check*

# debug logs
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# TypeScript
*.tsbuildinfo

