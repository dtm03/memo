@startuml

!define Table(name,desc) class name as "desc"
!define primary_key(x) <u>x</u>

' Media Class
Table(Media, "Media") {
    primary_key(mediaID: Long)
    title: String
    subtitle: String
    genre: String
    cover: byte[]
    link: String
}

' Creator Class
Table(Creator, "Creator") {
    primary_key(creatorID: Long)
    name: String
    lastName: String
}

' Memo Class
Table(Memo, "Memo") {
    primary_key(memoID: Long)
    quote: String
    creationDate: Date
    isVisible: boolean
}

' User Class
Table(User, "User") {
    primary_key(userID: Long)
}

' Book Class
Table(Book, "Book") {
    primary_key(ISBN: String)
}

' Movie Class
Table(Movie, "Movie") {
    primary_key(movieID: Long)
}

' Series Class
Table(Series, "Series") {
    primary_key(seriesID: Long)
    season: Integer
    episode: Integer
}

' Song Class
Table(Song, "Song") {
    primary_key(songID: Long)
    album: String
}

Table(Other, "Other"){
    primary_key(otherID: Long)
}

' Inheritance
Media <|-- Book
Media <|-- Movie
Media <|-- Series
Media <|-- Song
Media <|-- Other

' Relationships
User "1..*" -- "0..*" Memo : creates >
Memo "1..*" -- "1" Media : references >
Media "1..*" -- "1..*" Creator : created_by >
@enduml
