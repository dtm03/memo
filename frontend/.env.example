# Copy to `.env` and set your machine's LAN IP when testing on a physical device.
# Find IP: Windows `ipconfig`, macOS/Linux `ip addr` or `ifconfig`.
# Use http://localhost:8080/ for emulator/simulator on the same machine.
# Restart Expo after changing this (`npx expo start -c`).
EXPO_PUBLIC_SERVER_URL=http://192.168.0.100:8080/
